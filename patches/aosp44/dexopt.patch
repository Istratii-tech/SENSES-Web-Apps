diff --git a/dalvik/vm/mterp/out/InterpC-portable.cpp b/dalvik/vm/mterp/out/InterpC-portable.cpp
index f731cac1..db8de2f5 100644
--- a/dalvik/vm/mterp/out/InterpC-portable.cpp
+++ b/dalvik/vm/mterp/out/InterpC-portable.cpp
@@ -452,11 +452,39 @@ static inline bool checkForNullExportPC(Object* obj, u4* fp, const u2* pc)
  * While we're at it, see if a debugger has attached or the profiler has
  * started.  If so, switch to a different "goto" table.
  */
+#if defined(__wasm__)
+/*
+ * arc-wasm: a Java call tree runs in one call of the C interpreter, and
+ * WebAssembly engines without on-stack replacement (V8) keep running that
+ * call in whatever code it started with: the baseline compile, if the
+ * optimized one of this very large function was not ready yet. So a long
+ * loop (Looper.loop(), a benchmark) could stay twice as slow for good.
+ * Every kWasmBranchBudget backward branches the interpreter returns to
+ * dvmInterpret(), which calls it again; the branch is executed again, which
+ * has no side effects. A new call picks up the optimized code.
+ */
+#define kWasmBranchBudget 65536
+#define WASM_PERIODIC_REENTRY(_pcadj)                                       \
+        if ((_pcadj) < 0 && --self->wasmBranchBudget <= 0) {                \
+            self->wasmBranchBudget = kWasmBranchBudget;                     \
+            if (self->interpBreak.ctl.subMode == 0) {                       \
+                EXPORT_PC();                                                \
+                self->interpSave.method = curMethod;                        \
+                self->interpSave.pc = pc;                                   \
+                self->interpSave.curFrame = fp;                             \
+                self->wasmResume = true;                                    \
+                GOTO_bail();                                                \
+            }                                                               \
+        }
+#else
+#define WASM_PERIODIC_REENTRY(_pcadj)
+#endif
 #define PERIODIC_CHECKS(_pcadj) {                              \
         if (dvmCheckSuspendQuick(self)) {                                   \
             EXPORT_PC();  /* need for precise GC */                         \
             dvmCheckSuspendPending(self);                                   \
         }                                                                   \
+        WASM_PERIODIC_REENTRY(_pcadj)                                       \
     }
 
