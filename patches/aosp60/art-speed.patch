+template<bool do_access_check, bool transaction_active>
+JValue ExecuteSwitchImpl(Thread* self, const DexFile::CodeItem* code_item,
+                         ShadowFrame& shadow_frame, JValue result_register) {
+  ArtWasmResume resume = {nullptr, 0, JValue(), false, false, false};
+  JValue result = ExecuteSwitchImplLoop<do_access_check, transaction_active>(
+      self, code_item, shadow_frame, result_register, &resume);
+  while (UNLIKELY(resume.yielded)) {
+    resume.yielded = false;
+    if (resume.suspend) {
+      resume.suspend = false;
+      self->CheckSuspend();
+    }
+    if (UNLIKELY(resume.dex_pc_listeners)) {
+      // The rest of this call (its flat frames too) in the loop with access
+      // checks: it calls the listeners and makes no flat calls.
+      resume.dex_pc_listeners = false;
+      result = ExecuteSwitchImplLoop<true, transaction_active>(
+          self, code_item, shadow_frame, resume.result_register, &resume);
+    } else {
+      result = ExecuteSwitchImplLoop<do_access_check, transaction_active>(
+          self, code_item, shadow_frame, resume.result_register, &resume);
+    }
+  }
+  return result;
+}
