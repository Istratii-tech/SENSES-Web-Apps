+static jobject ICU_getMappedIcuData(JNIEnv* env, jclass, jstring javaPath) {
+    ScopedUtfChars path(env, javaPath);
+    if (path.c_str() == NULL) {
+        return NULL;
+    }
+    for (const IcuDataMapping& map : gIcuDataMappings) {
+        if (map.path == path.c_str()) {
+            return env->NewDirectByteBuffer(map.data, static_cast<jlong>(map.length));
+        }
+    }
