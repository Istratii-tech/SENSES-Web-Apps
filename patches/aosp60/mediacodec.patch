 void GLConsumer::EglImage::bindToTextureTarget(uint32_t texTarget) {
+#ifdef ARC_WASM
+    // arc-wasm: the buffer's pixels into the texture bound to texTarget
+    // (graphics_translation takes TexImage2D into an external texture, which
+    // it emulates as a TEXTURE_2D). Rows as in memory, as an EGLImage of the
+    // buffer would have them: getTransformMatrix's flip applies as usual.
+    const sp<GraphicBuffer>& b = mGraphicBuffer;
+    GLenum format, type;
+    size_t bpp;
+    switch (b->getPixelFormat()) {
+        case HAL_PIXEL_FORMAT_RGBA_8888:
+        case HAL_PIXEL_FORMAT_RGBX_8888:
+            format = GL_RGBA; type = GL_UNSIGNED_BYTE; bpp = 4;
+            break;
+        case HAL_PIXEL_FORMAT_RGB_565:
+            format = GL_RGB; type = GL_UNSIGNED_SHORT_5_6_5; bpp = 2;
+            break;
+        default:
+            ALOGE("bindToTextureTarget: no upload of pixel format %d", b->getPixelFormat());
+            return;
+    }
+    void* vaddr = NULL;
+    if (b->lock(GRALLOC_USAGE_SW_READ_OFTEN, &vaddr) != NO_ERROR || vaddr == NULL) {
+        ALOGE("bindToTextureTarget: cannot lock the buffer");
+        return;
+    }
+    const uint32_t w = b->getWidth(), h = b->getHeight(), stride = b->getStride();
+    const uint8_t* pixels = static_cast<const uint8_t*>(vaddr);
+    uint8_t* packed = NULL;
+    if (stride != w) {
+        packed = new uint8_t[w * h * bpp];
+        for (uint32_t y = 0; y < h; y++)
+            memcpy(packed + y * w * bpp, pixels + y * stride * bpp, w * bpp);
+        pixels = packed;
+    }
+    glPixelStorei(GL_UNPACK_ALIGNMENT, bpp == 4 ? 4 : 2);
+    glTexImage2D(texTarget, 0, format, w, h, 0, format, type, pixels);
+    delete[] packed;
+    b->unlock();
+    return;
+#endif
     glEGLImageTargetTexture2DOES(texTarget,
             static_cast<GLeglImageOES>(mEglImage));
 }
