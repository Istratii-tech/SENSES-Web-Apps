+// arc-wasm (art-string-init): the default exit hook (System.exit). Emscripten's
+// exit() hands the exit to the browser's (Node's) main thread, which runs the
+// C++ static destructors there; std::ios_base's flushes the standard streams
+// and waits for their locks. A thread holding stderr's lock while its write
+// waits for the main thread (a finalizer logging, say) never gets it:
+// deadlock. So: flush every stream on this thread, where waiting is fine;
+// on the main thread do the rest of what exit() does there except the
+// destructors (no arc-wasm code needs them): drop what keeps the runtime
+// alive (main() under PROXY_TO_PTHREAD) and close the JS file streams (the
+// terminal's last partial line); then _exit (proc_exit: threads terminated).
+static void ArtWasmReleaseMainThread(void*) {
+  while (emscripten_runtime_keepalive_check()) {
+    emscripten_runtime_keepalive_pop();
+  }
+  EM_ASM({ FS.quit(); });
+}
+
+static void ArtWasmExit(int status) {
+  std::cout.flush();
+  std::cerr.flush();
+  fflush(nullptr);
+  if (emscripten_is_main_runtime_thread()) {
+    ArtWasmReleaseMainThread(nullptr);
+  } else {
+    emscripten_proxy_sync(emscripten_proxy_get_system_queue(), emscripten_main_runtime_thread_id(),
+                          ArtWasmReleaseMainThread, nullptr);
+  }
+  _exit(status);
+}
+#endif
