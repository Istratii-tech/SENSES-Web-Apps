+#if defined(__EMSCRIPTEN__)
+// arc-wasm (art-string-init): after String.<init> (a StringFactory call),
+// puts the new string into every register of |sf| that holds the object of
+// the new-instance (register |this_vreg| of the invoke), as ART 7 does
+// (SetStringInitValueToAllAliases). AOSP 6.0 found those registers with
+// the verifier and cached them in Runtime::GetStringInitMap(), which any
+// thread changed without a lock. NEW_INSTANCE of String allocates a new
+// empty String each time, so a register holding it is a copy of the
+// new-instance's result. A register holds a reference only if its
+// reference slot agrees with its value (SetVReg clears the slot); ART 7
+// only DCHECKs that.
+ALWAYS_INLINE static inline void ArtWasmSetStringInitValueToAllAliases(ShadowFrame* sf,
+                                                                       uint32_t this_vreg,
+                                                                       mirror::Object* result)
+    SHARED_LOCKS_REQUIRED(Locks::mutator_lock_) {
+  mirror::Object* const existing = sf->GetVRegReference(this_vreg);
+  if (UNLIKELY(existing == nullptr)) {
+    sf->SetVRegReference(this_vreg, result);
+    return;
+  }
+  const uint32_t existing_value = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(existing));
+  for (uint32_t i = 0, e = sf->NumberOfVRegs(); i < e; ++i) {
+    if (sf->GetVRegReference(i) == existing &&
+        static_cast<uint32_t>(sf->GetVReg(i)) == existing_value) {
+      sf->SetVRegReference(i, result);
+    }
+  }
+}
+#endif
