diff --git a/art/runtime/mirror/class.cc b/art/runtime/mirror/class.cc
index 5bd65837..177eff0b 100644
--- a/art/runtime/mirror/class.cc
+++ b/art/runtime/mirror/class.cc
@@ -82,6 +82,14 @@ void Class::SetStatus(Handle<Class> h_this, Status new_status, Thread* self) {
     StackHandleScope<1> hs(self);
     Handle<mirror::Throwable> old_exception(hs.NewHandle(self->GetException()));
     CHECK(old_exception.Get() != nullptr);
+#ifdef __EMSCRIPTEN__
+    // arc-wasm: say why. Apps swallow the error, and all that is left later is
+    // "Rejecting re-init on previously-failed class".
+    if (class_linker_initialized) {
+      LOG(WARNING) << "Class " << PrettyClass(h_this.Get()) << " is erroneous: "
+                   << old_exception->Dump();
+    }
+#endif
     Class* eiie_class;
     // Do't attempt to use FindClass if we have an OOM error since this can try to do more
     // allocations and may cause infinite loops.
diff --git a/art/runtime/runtime.cc b/art/runtime/runtime.cc
index 79478dbe..5e74fa10 100644
--- a/art/runtime/runtime.cc
+++ b/art/runtime/runtime.cc
@@ -155,7 +155,12 @@ Runtime* Runtime::instance_ = nullptr;
 // destructors (no arc-wasm code needs them): drop what keeps the runtime
 // alive (main() under PROXY_TO_PTHREAD) and close the JS file streams (the
 // terminal's last partial line); then _exit (proc_exit: threads terminated).
-static void ArtWasmReleaseMainThread(void*) {
+static void ArtWasmReleaseMainThread(void* status) {
+  // arc-wasm (tiktok): the exit status first. Without keepalive the main
+  // thread exits by itself right after this call (maybeExit: _exit with
+  // EXITSTATUS, then 0), before the calling thread's _exit(status) reaches
+  // it: every System.exit(N) ended the process with 0.
+  EM_ASM({ EXITSTATUS = $0; }, static_cast<int>(reinterpret_cast<intptr_t>(status)));
   while (emscripten_runtime_keepalive_check()) {
     emscripten_runtime_keepalive_pop();
   }
@@ -166,11 +171,12 @@ static void ArtWasmExit(int status) {
   std::cout.flush();
   std::cerr.flush();
   fflush(nullptr);
+  void* arg = reinterpret_cast<void*>(static_cast<intptr_t>(status));
   if (emscripten_is_main_runtime_thread()) {
-    ArtWasmReleaseMainThread(nullptr);
+    ArtWasmReleaseMainThread(arg);
   } else {
     emscripten_proxy_sync(emscripten_proxy_get_system_queue(), emscripten_main_runtime_thread_id(),
-                          ArtWasmReleaseMainThread, nullptr);
+                          ArtWasmReleaseMainThread, arg);
   }
   _exit(status);
 }
