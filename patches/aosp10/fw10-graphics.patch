+#ifdef ARC_WASM
+// arc-wasm: graphic buffers are memory (the software gralloc of topic
+// fw6-graphics) and hwui's GL is WebGL2 on the RenderThread only, which has
+// no EGLImage: a hardware bitmap's pixels are written into its buffer by the
+// CPU, as RGB_565 or N32 (RGBA_8888, premultiplied); Bitmap reads them back
+// the same way (hwui/Bitmap.cpp).
+static sk_sp<Bitmap> arcWasmAllocateHardwareBitmap(const SkBitmap& sourceBitmap) {
+    const bool is565 = sourceBitmap.colorType() == kRGB_565_SkColorType;
+    const SkImageInfo info = sourceBitmap.info().makeColorType(
+            is565 ? kRGB_565_SkColorType : kN32_SkColorType);
+    sp<GraphicBuffer> buffer = new GraphicBuffer(
+            static_cast<uint32_t>(info.width()), static_cast<uint32_t>(info.height()),
+            is565 ? PIXEL_FORMAT_RGB_565 : PIXEL_FORMAT_RGBA_8888,
+            GraphicBuffer::USAGE_HW_TEXTURE | GraphicBuffer::USAGE_SW_WRITE_OFTEN |
+                    GraphicBuffer::USAGE_SW_READ_OFTEN,
+            std::string("Bitmap::allocateHardwareBitmap pid [") + std::to_string(getpid()) +
+                    "]");
+    if (buffer->initCheck() < 0) {
+        ALOGW("createGraphicBuffer() failed in GraphicBuffer.create()");
+        return nullptr;
+    }
+    void* vaddr = nullptr;
+    if (buffer->lock(GraphicBuffer::USAGE_SW_WRITE_OFTEN, &vaddr) != OK || !vaddr) {
+        return nullptr;
+    }
+    const size_t rowBytes = static_cast<size_t>(buffer->getStride()) * info.bytesPerPixel();
+    const bool ok = sourceBitmap.readPixels(info, vaddr, rowBytes, 0, 0);
+    buffer->unlock();
+    if (!ok) {
+        return nullptr;
+    }
+    return Bitmap::createFrom(buffer, info.colorType(), sourceBitmap.refColorSpace(),
+                              sourceBitmap.alphaType(), Bitmap::computePalette(sourceBitmap));
+}
+#endif
