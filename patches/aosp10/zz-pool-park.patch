+
 void NativeMessageQueue::pollOnce(JNIEnv* env, jobject pollObj, int timeoutMillis) {
+#if defined(__EMSCRIPTEN__)
+    // A long wait: the grace period as usual, then (nothing came) without the
+    // worker; the Java loop takes it as an early return of this poll.
+    const int grace = arc_java_dormant_grace_ms ? arc_java_dormant_grace_ms() : -1;
+    if (grace >= 0 && (timeoutMillis < 0 || timeoutMillis > grace)) {
+        const nsecs_t start = systemTime(SYSTEM_TIME_MONOTONIC);
+        mPollEnv = env;
+        mPollObj = pollObj;
+        const int result = mLooper->pollOnce(grace);
+        mPollObj = NULL;
+        mPollEnv = NULL;
+        if (mExceptionObj) {
+            env->Throw(mExceptionObj);
+            env->DeleteLocalRef(mExceptionObj);
+            mExceptionObj = NULL;
+            return;
+        }
+        if (result != Looper::POLL_TIMEOUT) {
+            return;
+        }
+        if (timeoutMillis >= 0) {
+            timeoutMillis -= static_cast<int>(ns2ms(systemTime(SYSTEM_TIME_MONOTONIC) - start));
+            if (timeoutMillis <= 0) {
+                return;
+            }
+        }
+        const int epfd = mLooper->getEpollFdForDormantWait();
+        if (epfd >= 0) {
+            arc_java_dormant_epoll(epfd, timeoutMillis, ArcLooperResumed, mLooper.get());
+        }
+    }
+#endif
     mPollEnv = env;
     mPollObj = pollObj;
     mLooper->pollOnce(timeoutMillis);
