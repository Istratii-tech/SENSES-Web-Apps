+#if defined(__EMSCRIPTEN__)
+  // arc-wasm (topic boot-dex): read-only, so that a stored entry of a file of
+  // the /system image is the image's own pages, not a copy
+  // (posix_translation's readonly_file.cc: a MAP_PRIVATE mapping without
+  // PROT_WRITE). Write protection is not enforced in wasm (mprotect is a no-op
+  // for ART, shim/art10/art_runtime_wasm10.h); the one writer, run-time
+  // quickening, says so first (ClassVerifier::VerifyClass), and
+  // readonly_file.cc keeps the image's bytes for other readers of the file.
+  const int prot = PROT_READ;
+#else
+  const int prot = PROT_READ | PROT_WRITE;
+#endif
   MemMap map =
       MemMap::MapFile(GetUncompressedLength(),  // Byte count
-                      PROT_READ | PROT_WRITE,
+                      prot,
                       MAP_PRIVATE,
                       zip_fd,
                       offset,
