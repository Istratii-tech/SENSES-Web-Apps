 static jlong Linux_sysconf(JNIEnv* env, jobject, jint name) {
+#if defined(__EMSCRIPTEN__)
+    // arc-wasm (topic native-exec): apps see 4 KB pages, as on ARM (their
+    // native code does too: shim/ndk G_sysconf, AT_PAGESZ); the VM's own
+    // pages are WebAssembly's 64 KB, and mmap takes offsets in 4 KB steps.
+    if (name == _SC_PAGESIZE || name == _SC_PAGE_SIZE) {
+        return 4096;
+    }
+#endif
     // Since -1 is a valid result from sysconf(3), detecting failure is a little more awkward.
     errno = 0;
     long result = sysconf(name);
