+// The table records of the font (of font ttcIndex of a collection).
+bool readFileFaceTables(int fd, uint32_t ttcIndex, std::vector<FileFaceTable>* out) {
+    struct stat st;
+    if (fstat(fd, &st) != 0) return false;
+    uint8_t header[12];
+    if (!preadFully(fd, header, sizeof(header), 0)) return false;
+    uint32_t base = 0;
+    if (readBe32(header) == MinikinFont::MakeTag('t', 't', 'c', 'f')) {
+        if (ttcIndex >= readBe32(header + 8)) return false;
+        uint8_t offset[4];
+        if (!preadFully(fd, offset, sizeof(offset), 12 + 4 * ttcIndex)) return false;
+        base = readBe32(offset);
+        if (!preadFully(fd, header, sizeof(header), base)) return false;
+    }
+    const uint32_t numTables = (uint32_t(header[4]) << 8) | header[5];
+    std::vector<uint8_t> records(16 * numTables);
+    if (!preadFully(fd, records.data(), records.size(), base + 12)) return false;
+    for (uint32_t i = 0; i < numTables; i++) {
+        const uint8_t* r = &records[16 * i];
+        FileFaceTable t = {readBe32(r), readBe32(r + 8), readBe32(r + 12)};
+        if (uint64_t(t.offset) + t.length > uint64_t(st.st_size)) continue;
+        out->push_back(t);
+    }
+    return true;
+}
