+        return hb_blob_create(reinterpret_cast<const char*>(addr) + (t.offset - start), t.length,
+                              HB_MEMORY_MODE_READONLY, mapping, [](void* p) {
+                                  FileFaceMapping* m = reinterpret_cast<FileFaceMapping*>(p);
+                                  munmap(m->addr, m->length);
+                                  delete m;
+                              });
+    }
+    return nullptr;
+}
+
+uint16_t readBe16(const uint8_t* p) {
+    return (uint16_t(p[0]) << 8) | p[1];
+}
+
+// HarfBuzz's hb_font_t::em_scale.
+hb_position_t emScale(int16_t v, int scale, int upem) {
+    int64_t scaled = v * (int64_t)scale;
+    scaled += scaled >= 0 ? upem / 2 : -upem / 2;
+    return (hb_position_t)(scaled / upem);
+}
+
+bool fileFaceBitmapExtentsInFontUnits(FileFace* face, hb_font_t* font, hb_codepoint_t glyph,
+                                      hb_glyph_extents_t* extents) {
+    FileFaceBitmaps& b = face->bitmaps;
+    std::call_once(b.once, [&]() {
+        hb_face_t* hbFace = hb_font_get_face(font);
+        b.cblc = hb_face_reference_table(hbFace, MinikinFont::MakeTag('C', 'B', 'L', 'C'));
+        b.upem = hb_face_get_upem(hbFace);
+        const FileFaceTable* cbdt = face->find(MinikinFont::MakeTag('C', 'B', 'D', 'T'));
+        uint8_t version[4];
+        int fd = open(face->path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (cbdt != nullptr && fd >= 0 && cbdt->length >= 4 &&
+            preadFully(fd, version, sizeof(version), cbdt->offset) &&
+            (readBe16(version) == 2 || readBe16(version) == 3)) {
+            b.cbdtOffset = cbdt->offset;
+            b.cbdtLength = cbdt->length;
+        }
+        if (fd >= 0) close(fd);
+    });
+    unsigned int cblcLength = 0;
+    const uint8_t* cblc = reinterpret_cast<const uint8_t*>(hb_blob_get_data(b.cblc, &cblcLength));
+    auto inCblc = [&](size_t offset, size_t length) {
+        return offset <= cblcLength && cblcLength - offset >= length;
+    };
+    // CBLC: version, sizeTables (BitmapSizeTable: 48 bytes).
+    if (!inCblc(0, 8) || (readBe16(cblc) != 2 && readBe16(cblc) != 3)) return false;
+    const uint32_t count = readBe32(cblc + 4);
+    if (count == 0 || !inCblc(8, uint64_t(count) * 48)) return false;
+    // CBLC::choose_strike
+    unsigned int xPpem, yPpem;
+    hb_font_get_ppem(font, &xPpem, &yPpem);
+    unsigned int requestedPpem = std::max(xPpem, yPpem);
+    if (!requestedPpem) requestedPpem = 1 << 30;
+    auto strikePpem = [&](uint32_t i) {
+        const uint8_t* t = cblc + 8 + 48 * i;
+        return std::max<unsigned int>(t[44], t[45]);
+    };
+    uint32_t best = 0;
+    unsigned int bestPpem = strikePpem(0);
+    for (uint32_t i = 1; i < count; i++) {
+        unsigned int ppem = strikePpem(i);
+        if ((requestedPpem <= ppem && ppem < bestPpem) ||
+            (requestedPpem > bestPpem && ppem > bestPpem)) {
+            best = i;
+            bestPpem = ppem;
+        }
+    }
+    const uint8_t* strike = cblc + 8 + 48 * best;
+    const unsigned int ppemX = strike[44], ppemY = strike[45];
+    // BitmapSizeTable::find_table
+    const uint32_t arrayOffset = readBe32(strike);
+    const uint32_t numSubtables = readBe32(strike + 8);
+    if (!inCblc(arrayOffset, uint64_t(numSubtables) * 8)) return false;
+    const uint8_t* record = nullptr;
+    for (uint32_t i = 0; i < numSubtables; i++) {
+        const uint8_t* r = cblc + arrayOffset + 8 * i;
+        if (readBe16(r) <= glyph && glyph <= readBe16(r + 2)) {
+            record = r;
+            break;
+        }
+    }
+    if (record == nullptr || !ppemX || !ppemY) return false;
+    // IndexSubtableRecord::get_image_data (index formats 1 and 3)
+    const uint32_t first = readBe16(record), last = readBe16(record + 2);
+    const uint64_t subtable = uint64_t(arrayOffset) + readBe32(record + 4);
+    if (glyph < first || glyph > last || !inCblc(subtable, 8)) return false;
+    const uint8_t* header = cblc + subtable;
+    const uint16_t indexFormat = readBe16(header);
+    const uint16_t imageFormat = readBe16(header + 2);
+    const uint32_t idx = glyph - first;
+    uint32_t start, end;
+    if (indexFormat == 1) {
+        if (!inCblc(subtable + 8, (uint64_t(idx) + 2) * 4)) return false;
+        start = readBe32(header + 8 + 4 * idx);
+        end = readBe32(header + 8 + 4 * (idx + 1));
+    } else if (indexFormat == 3) {
+        if (!inCblc(subtable + 8, (uint64_t(idx) + 2) * 2)) return false;
+        start = readBe16(header + 8 + 2 * idx);
+        end = readBe16(header + 8 + 2 * (idx + 1));
+    } else {
+        return false;
+    }
+    if (end <= start) return false;
+    const uint32_t imageOffset = readBe32(header + 4) + start;
+    const uint32_t imageLength = end - start;
+    if (imageOffset > b.cbdtLength || b.cbdtLength - imageOffset < imageLength) return false;
+    if (imageFormat == 17) {
+        if (imageLength < 9) return false;
+    } else if (imageFormat == 18) {
+        if (imageLength < 12) return false;
+    } else {
+        return false;
+    }
+    // Small (17) and big (18) glyph metrics start with height, width,
+    // bearingX, bearingY.
+    uint8_t metrics[4];
+    int fd = open(face->path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return false;
+    const bool read = preadFully(fd, metrics, sizeof(metrics), b.cbdtOffset + imageOffset);
+    close(fd);
+    if (!read) return false;
+    extents->x_bearing = int8_t(metrics[2]);
+    extents->y_bearing = int8_t(metrics[3]);
+    extents->width = metrics[1];
+    extents->height = -int(metrics[0]);
+    const double xScale = b.upem / (double)ppemX;
+    const double yScale = b.upem / (double)ppemY;
+    extents->x_bearing = round(extents->x_bearing * xScale);
+    extents->y_bearing = round(extents->y_bearing * yScale);
+    extents->width = round(extents->width * xScale);
+    extents->height = round(extents->height * yScale);
+    return true;
+}
+
+// hb_ot_get_glyph_extents for a font whose only glyph data is CBDT.
+hb_bool_t fileFaceBitmapExtents(hb_font_t* font, void* fontData, hb_codepoint_t glyph,
+                                hb_glyph_extents_t* extents, void* /* userData */) {
+    FileFace* face = reinterpret_cast<FileFace*>(fontData);
+    const bool ret = fileFaceBitmapExtentsInFontUnits(face, font, glyph, extents);
+    int xScale, yScale;
+    hb_font_get_scale(font, &xScale, &yScale);
+    const int upem = hb_face_get_upem(hb_font_get_face(font));
+    extents->x_bearing = emScale(extents->x_bearing, xScale, upem);
+    extents->y_bearing = emScale(extents->y_bearing, yScale, upem);
+    extents->width = emScale(extents->width, xScale, upem);
+    extents->height = emScale(extents->height, yScale, upem);
+    return ret;
+}
+
+hb_font_funcs_t* fileFaceBitmapFuncs() {
+    static hb_font_funcs_t* funcs = nullptr;
+    static std::once_flag once;
+    std::call_once(once, [&]() {
+        funcs = hb_font_funcs_create();
+        hb_font_funcs_set_glyph_extents_func(funcs, fileFaceBitmapExtents, nullptr, nullptr);
+        hb_font_funcs_make_immutable(funcs);
+    });
+    return funcs;
+}
+
+// Whether HarfBuzz would take glyph extents from CBDT (hb_ot_get_glyph_extents
+// tries sbix, glyf, CFF and CFF2 first).
+bool usesBitmapExtents(const FileFace* face) {
+    return face->find(MinikinFont::MakeTag('C', 'B', 'D', 'T')) != nullptr &&
+           face->find(MinikinFont::MakeTag('C', 'B', 'L', 'C')) != nullptr &&
+           face->find(MinikinFont::MakeTag('s', 'b', 'i', 'x')) == nullptr &&
+           face->find(MinikinFont::MakeTag('g', 'l', 'y', 'f')) == nullptr &&
+           face->find(MinikinFont::MakeTag('C', 'F', 'F', ' ')) == nullptr &&
+           face->find(MinikinFont::MakeTag('C', 'F', 'F', '2')) == nullptr;
+}
+
+HbFaceUniquePtr createFileFace(const char* path, uint32_t ttcIndex) {
+    std::unique_ptr<FileFace> face(new FileFace{path, {}});
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || !readFileFaceTables(fd, ttcIndex, &face->tables)) {
+        ALOGE("Could not read the table directory of %s", path);
+    }
+    if (fd >= 0) close(fd);
+    FileFace* fileFace = face.release();
+    hb_face_t* hbFace = hb_face_create_for_tables(
+            referenceFileFaceTable, fileFace,
+            [](void* p) { delete reinterpret_cast<FileFace*>(p); });
+    hb_face_set_user_data(hbFace, &gFileFaceKey, fileFace, nullptr, false);
+    hb_face_set_index(hbFace, ttcIndex);
+    return HbFaceUniquePtr(hbFace);
+}
+
+}  // namespace
+
+bool fileFaceHasTable(hb_face_t* face, uint32_t tag, bool* hasTable) {
+    const FileFace* fileFace =
+            reinterpret_cast<const FileFace*>(hb_face_get_user_data(face, &gFileFaceKey));
+    if (fileFace == nullptr) return false;
+    *hasTable = fileFace->find(tag) != nullptr;
+    return true;
+}
