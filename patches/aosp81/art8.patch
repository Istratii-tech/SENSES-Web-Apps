+
+// What ArtInterpreterToInterpreterBridge does before running a method: push
+// its frame, initialize the class of a static method. On failure the frame
+// is gone and an exception is pending.
+NO_INLINE static bool ArtWasmFlatEnterInitialize(Thread* self, ShadowFrame* callee,
+                                                 ObjPtr<mirror::Class> declaring_class)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  StackHandleScope<1> hs(self);
+  HandleWrapperObjPtr<mirror::Class> h_declaring_class(hs.NewHandleWrapper(&declaring_class));
+  if (UNLIKELY(!Runtime::Current()->GetClassLinker()->EnsureInitialized(
+      self, h_declaring_class, true, true))) {
+    DCHECK(self->IsExceptionPending());
+    self->PopShadowFrame();
+    ArtWasmFlatFrameFree(callee);  // (see flat_return)
+    return false;
+  }
+  return true;
+}
+
+ALWAYS_INLINE static bool ArtWasmFlatEnter(Thread* self, ShadowFrame* callee)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  self->PushShadowFrame(callee);
+  ArtMethod* const method = callee->GetMethod();
+  if (method->IsStatic()) {
+    ObjPtr<mirror::Class> declaring_class = method->GetDeclaringClass();
+    if (UNLIKELY(!declaring_class->IsInitialized())) {
+      return ArtWasmFlatEnterInitialize(self, callee, declaring_class);
+    }
+  }
+  return true;
+}
+
+// Returns to ExecuteSwitchImpl, which continues at the current frame's dex
+// pc: after the thread's suspend check if |_suspend|, in the loop that
+// calls listeners if |_listeners|.
+#define ART_WASM_YIELD(_suspend, _listeners)                        \
+  do {                                                              \
+    resume->sf = flat_sf;                                           \
+    resume->depth = flat_depth;                                     \
+    resume->result_register = result_register;                     \
+    resume->yielded = true;                                         \
+    resume->suspend = (_suspend);                                   \
+    resume->listeners = (_listeners);                               \
+    return JValue();                                                \
+  } while (false)
+
+// Thread::AllowThreadSuspension at returns (backward branches: below). In
+// the flat loop the suspend check runs in ExecuteSwitchImpl, which then
+// executes the instruction again: a call here made the JavaScript engine
+// save registers on the stack on every return and branch.
+#define ART_WASM_SUSPEND_CHECK()                                    \
+  do {                                                              \
+    if (kFlatCalls) {                                               \
+      if (UNLIKELY(self->TestAllFlags())) {                         \
+        shadow_frame.SetDexPC(dex_pc);                              \
+        ART_WASM_YIELD(true, false);                                \
+      }                                                             \
+    } else {                                                        \
+      self->AllowThreadSuspension();                                \
+    }                                                               \
+  } while (false)
+
+// Method exit listeners in the flat loop: the return is executed again in
+// the loop that calls them.
+#define ART_WASM_EXIT_LISTENERS_CHECK()                                     \
+  do {                                                                      \
+    if (kFlatCalls && UNLIKELY(instrumentation->HasMethodExitListeners())) { \
+      ART_WASM_YIELD(false, true);                                          \
+    }                                                                       \
+  } while (false)
+
+// Backward branches: the suspend check, with the target as the dex pc (as
+// AOSP's HANDLE_BACKWARD_BRANCH). Every kYieldBranches-th backward branch
+// the loop also returns to ExecuteSwitchImpl, which calls it again at the
+// target. V8 has no on-stack replacement for WebAssembly: a call that
+// started in baseline (Liftoff) code stays there until it returns, and with
+// flat calls the outermost loop runs a thread's whole Java call tree (for an
+// app, Looper.loop() never returns). A new call runs the optimized code once
+// it is ready.
+#define HANDLE_BACKWARD_BRANCH(offset)                                      \
+  do {                                                                      \
+    if (kFlatCalls) {                                                       \
+      if (IsBackwardBranch(offset)) {                                       \
+        shadow_frame.SetDexPC(inst->GetDexPc(insns));                       \
+        if (UNLIKELY(self->TestAllFlags())) {                               \
+          ART_WASM_YIELD(true, false);                                      \
+        }                                                                   \
+        if (UNLIKELY(--yield_countdown == 0)) {                             \
+          ART_WASM_YIELD(false, false);                                     \
+        }                                                                   \
+      }                                                                     \
+    } else {                                                                \
+      ART_WASM_AOSP_HANDLE_BACKWARD_BRANCH(offset);                         \
+    }                                                                       \
+  } while (false)
+
+// Branch listeners and on-stack replacement (JIT): never in the flat loop
+// (see ART_WASM_LISTENERS_CHECK; there is no JIT).
+#define BRANCH_INSTRUMENTATION(offset)                                      \
+  do {                                                                      \
+    if (!kFlatCalls) {                                                      \
+      ART_WASM_AOSP_BRANCH_INSTRUMENTATION(offset);                         \
+    }                                                                       \
+  } while (false)
+
+static constexpr uint32_t kYieldBranches = 65536;
+
+// Where ExecuteSwitchImplLoop continues after it yielded.
+struct ArtWasmResume {
+  ShadowFrame* sf;  // the current frame (a flat callee, or the method's own)
+  size_t depth;     // flat_depth
+  JValue result_register;
+  bool yielded;
