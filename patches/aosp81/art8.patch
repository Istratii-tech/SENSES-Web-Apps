+      ART_WASM_FLAT_ENTER(fast_callee);                                 \
+    } else {                                                            \
+      ART_WASM_FLAT_INVOKE(__VA_ARGS__);                                \
+    }                                                                   \
+  } while (false)
+
+// ArtWasmTryFlatInvoke's result for a native method (|*native| is set):
+// ArtWasmCallNativeFromLoop runs it.
+static ShadowFrame* const kArtWasmNativeCall = reinterpret_cast<ShadowFrame*>(16);
+
+// ArtWasmTryFlatInvoke's result for a method marked intrinsic (|*native| is
+// set; non-range invokes only): MterpHandleIntrinsic (interpreter_intrinsics.cc)
+// computes it from the caller's registers, or punts (an exception to throw,
+// a supplementary character) to the usual call.
+static ShadowFrame* const kArtWasmIntrinsicCall = reinterpret_cast<ShadowFrame*>(24);
+
+// ArtWasmTryFlatInvoke's result for invoke-direct of a method whose code
+// is one return-void (Object.<init> of every object allocation, empty
+// constructors and private methods): nothing to run. Like Dalvik's
+// invoke-object-init: in the flat loop nobody listens to the call
+// (ArtWasmCanCallFlat), and ART registers finalizable objects when it
+// allocates them, not in Object.<init>.
+static ShadowFrame* const kArtWasmEmptyCall = reinterpret_cast<ShadowFrame*>(8);
+
+// arc-wasm (art-speed): new-instance and new-array out of the loop, with
+// the allocation code compiled code would use: uninstrumented (the
+// thread-local RosAlloc path) unless the allocation entrypoints are
+// instrumented. AOSP's interpreter always takes the instrumented path.
+template<bool do_access_check>
+NO_INLINE static mirror::Object* ArtWasmNewInstance(
+    Thread* self, ArtMethod* method, dex::TypeIndex type_idx,
+    const instrumentation::Instrumentation* instrumentation)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  ObjPtr<mirror::Class> c = ResolveVerifyAndClinit(type_idx, method, self, false, do_access_check);
+  if (UNLIKELY(c == nullptr)) {
+    return nullptr;
+  }
+  gc::AllocatorType allocator_type = Runtime::Current()->GetHeap()->GetCurrentAllocator();
+  if (UNLIKELY(c->IsStringClass())) {
+    return mirror::String::AllocEmptyString<true>(self, allocator_type);
+  }
+  if (instrumentation->AllocEntrypointsInstrumented()) {
+    return AllocObjectFromCode<true>(c.Ptr(), self, allocator_type);
+  }
+  return AllocObjectFromCode<false>(c.Ptr(), self, allocator_type);
+}
+
+template<bool do_access_check>
+NO_INLINE static mirror::Object* ArtWasmNewArray(
+    Thread* self, ArtMethod* method, dex::TypeIndex type_idx, int32_t length,
+    const instrumentation::Instrumentation* instrumentation)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  gc::AllocatorType allocator_type = Runtime::Current()->GetHeap()->GetCurrentAllocator();
+  if (instrumentation->AllocEntrypointsInstrumented()) {
+    return AllocArrayFromCode<do_access_check, true>(type_idx, length, method, self,
+                                                     allocator_type);
+  }
+  return AllocArrayFromCode<do_access_check, false>(type_idx, length, method, self,
+                                                    allocator_type);
+}
+
+// AssignRegister of interpreter_common.cc.
+ALWAYS_INLINE static void ArtWasmAssignRegister(ShadowFrame* new_shadow_frame,
+                                                const ShadowFrame& shadow_frame,
+                                                size_t dest_reg, size_t src_reg)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  uint32_t src_value = shadow_frame.GetVReg(src_reg);
+  mirror::Object* o = shadow_frame.GetVRegReference<kVerifyNone>(src_reg);
+  if (src_value == reinterpret_cast<uintptr_t>(o)) {
+    new_shadow_frame->SetVRegReference(dest_reg, o);
+  } else {
+    new_shadow_frame->SetVReg(dest_reg, src_value);
+  }
+}
+
+// ImTable::GetImtIndex of ART 8.1 hashes the method's class descriptor,
+// name and signature: on a device compiled code has the index built in, the
+// interpreter computes it on every invoke-interface. Cached here per method
+// (lock-free, direct-mapped; a 64-bit atomic holds method and index
+// together, so a reader never sees one with the other's partner).
+ALWAYS_INLINE static uint32_t ArtWasmImtIndex(ArtMethod* interface_method)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  constexpr size_t kBits = 12;
+  static std::atomic<uint64_t> cache[1u << kBits];
+  const uint32_t key = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(interface_method));
+  std::atomic<uint64_t>& slot = cache[(key * 2654435761u) >> (32 - kBits)];
+  const uint64_t v = slot.load(std::memory_order_relaxed);
+  if (LIKELY(static_cast<uint32_t>(v) == key)) {
+    return static_cast<uint32_t>(v >> 32);
+  }
+  const uint32_t index = ImTable::GetImtIndex(interface_method);
+  slot.store((static_cast<uint64_t>(index) << 32) | key, std::memory_order_relaxed);
+  return index;
+}
+
+// What DoInvoke (FindMethodFromCode without access checks, then
+// DoCallCommon's fast path) does for a call to an interpreted method whose
+// reference is resolved, when it can be flat: returns the callee's frame
+// with the arguments, not pushed. nullptr for everything else (unresolved,
+// null receiver, not invokable, native, String.<init>, IMT conflict,
+// invoke-super, frame stack full): DoInvoke handles those as before.
+// Not inlined: in the ten invoke cases it made the loop function so large
+// (69 KB of wasm instead of 58) that Safari's JavaScriptCore kept it out of
+// its optimizing tier: Bench 167 ms there, 110 out of line (Node: the same).
+template<InvokeType type, bool is_range>
+NO_INLINE static ShadowFrame* ArtWasmTryFlatInvoke(Thread* self, ShadowFrame* caller,
+                                                       const Instruction* inst,
+                                                       uint16_t inst_data,
+                                                       ArtMethod** native)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (type == kSuper) {
+    return nullptr;  // (super calls of interface default methods: DoInvoke)
+  }
+  const uint32_t method_idx = is_range ? inst->VRegB_3rc() : inst->VRegB_35c();
+  const uint32_t vregC = is_range ? inst->VRegC_3rc() : inst->VRegC_35c();
+  mirror::Object* receiver = nullptr;
+  if (type != kStatic) {
+    receiver = caller->GetVRegReference(vregC);
+    if (UNLIKELY(receiver == nullptr)) {
+      return nullptr;
+    }
+  }
+  ArtMethod* const referrer = caller->GetMethod();
+  ArtMethod* const resolved =
+      referrer->GetDexCache()->GetResolvedMethod(method_idx, kRuntimePointerSize);
+  if (UNLIKELY(resolved == nullptr || resolved->IsRuntimeMethod())) {
+    return nullptr;
+  }
+  ArtMethod* m;
+  switch (type) {
+    case kStatic:
+    case kDirect:
+      m = resolved;
+      break;
+    case kVirtual:
+      // The class of an object is instantiable: its vtable is embedded.
+      m = receiver->GetClass()->GetEmbeddedVTableEntry(resolved->GetMethodIndex(),
+                                                        kRuntimePointerSize);
+      break;
+    case kInterface: {
+      m = receiver->GetClass()->GetImt(kRuntimePointerSize)->Get(
+          ArtWasmImtIndex(resolved), kRuntimePointerSize);
+      if (UNLIKELY(m->IsRuntimeMethod())) {  // conflict or unimplemented
+        return nullptr;
+      }
+      break;
+    }
+    default:
+      return nullptr;
+  }
+  if (!is_range && UNLIKELY(m->IsIntrinsic())) {
+    *native = m;
+    return kArtWasmIntrinsicCall;
+  }
+  const DexFile::CodeItem* const code_item = m->GetCodeItem();
+  if (code_item == nullptr && m->IsNative() && !m->IsConstructor() &&
+      LIKELY(Runtime::Current()->IsStarted())) {
+    *native = m;
+    return kArtWasmNativeCall;
+  }
+  if (UNLIKELY(code_item == nullptr || !m->IsInvokable() ||
+               (type == kDirect && m->IsConstructor() &&
+                m->GetDeclaringClass()->IsStringClass()) ||
+               !ArtWasmCanCallFlat(self, m))) {
+    return nullptr;
+  }
+  if (type == kDirect && code_item->insns_size_in_code_units_ == 1 &&
+      ((code_item->insns_[0] & 0xff) == Instruction::RETURN_VOID ||
+       (code_item->insns_[0] & 0xff) == Instruction::RETURN_VOID_NO_BARRIER)) {
+    return kArtWasmEmptyCall;
+  }
+  const uint16_t num_regs = code_item->registers_size_;
+  const uint16_t num_ins = is_range ? inst->VRegA_3rc(inst_data) : inst->VRegA_35c(inst_data);
+  DCHECK_EQ(num_ins, code_item->ins_size_);
+  void* memory = ArtWasmFlatFrameAlloc(ShadowFrame::ComputeSize(num_regs));
+  if (UNLIKELY(memory == nullptr)) {
+    return nullptr;
+  }
+  ShadowFrame* callee = ShadowFrame::CreateForCall(num_regs, num_ins, caller, m, memory);
+  callee->SetCodeItem(code_item);  // (flat frames keep their code item: see flat_return)
+  const size_t first_dest_reg = num_regs - num_ins;
+  if (is_range) {
+    for (size_t src_reg = vregC, dest_reg = first_dest_reg; dest_reg < num_regs;
+         ++dest_reg, ++src_reg) {
+      ArtWasmAssignRegister(callee, *caller, dest_reg, src_reg);
+    }
+  } else {
+    uint16_t reg_list = inst->Fetch16(2);
+    uint16_t count = num_ins;
+    if (count == 5) {
+      ArtWasmAssignRegister(callee, *caller, first_dest_reg + 4U, (inst_data >> 8) & 0x0f);
+      --count;
+    }
+    for (size_t arg_index = 0; arg_index < count; ++arg_index, reg_list >>= 4) {
+      ArtWasmAssignRegister(callee, *caller, first_dest_reg + arg_index, reg_list & 0x0f);
+    }
+  }
+  return callee;
+}
+
+// A native method from the flat loop (ArtWasmTryFlatInvoke found |m|): what
+// DoCallCommon does for it (a frame with the arguments, ArtWasmCallNative),
+// without FindMethodFromCode and DoCallCommon's generality. The frame comes
+// from the frame stack (LIFO, freed right after). False with an exception
+// pending.
+template<bool is_range>
+NO_INLINE static bool ArtWasmCallNativeFromLoop(Thread* self, ShadowFrame* caller,
+                                                const Instruction* inst, uint16_t inst_data,
+                                                ArtMethod* m, JValue* result)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  const uint32_t vregC = is_range ? inst->VRegC_3rc() : inst->VRegC_35c();
+  const uint16_t num_ins = is_range ? inst->VRegA_3rc(inst_data) : inst->VRegA_35c(inst_data);
+  void* memory = ArtWasmFlatFrameAlloc(ShadowFrame::ComputeSize(num_ins));
+  if (UNLIKELY(memory == nullptr)) {
+    ThrowStackOverflowError(self);
+    return false;
+  }
+  ShadowFrame* frame = ShadowFrame::CreateForCall(num_ins, num_ins, caller, m, memory);
+  if (is_range) {
+    for (size_t i = 0; i < num_ins; ++i) {
+      ArtWasmAssignRegister(frame, *caller, i, vregC + i);
+    }
+  } else {
+    uint16_t reg_list = inst->Fetch16(2);
+    uint16_t count = num_ins;
+    if (count == 5) {
+      ArtWasmAssignRegister(frame, *caller, 4U, (inst_data >> 8) & 0x0f);
+      --count;
+    }
+    for (size_t arg_index = 0; arg_index < count; ++arg_index, reg_list >>= 4) {
+      ArtWasmAssignRegister(frame, *caller, arg_index, reg_list & 0x0f);
+    }
+  }
+  ArtWasmCallNative(self, frame, result);
+  ArtWasmFlatFrameFree(frame);
+  return !self->IsExceptionPending();
+}
+
+// arc-wasm (art-speed): sget/sput (DoFieldGet/DoFieldPut of static fields)
+// with the common case inline: the field is resolved, its class
+// initialized, no field listeners; FindFieldFromCode without access checks
+// would return the same field.
+template<bool do_access_check>
+ALWAYS_INLINE static ArtField* ArtWasmResolvedStaticField(const ShadowFrame& sf,
+                                                          const Instruction* inst)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (do_access_check) {
+    return nullptr;
+  }
+  ArtField* f = sf.GetMethod()->GetDexCache()->GetResolvedField(inst->VRegB_21c(),
+                                                                 kRuntimePointerSize);
+  if (UNLIKELY(f == nullptr || !f->IsStatic() || !f->GetDeclaringClass()->IsInitialized())) {
+    return nullptr;
+  }
+  return f;
+}
+
+template<FindFieldType find_type, Primitive::Type field_type, bool do_access_check>
+ALWAYS_INLINE static bool ArtWasmSGet(Thread* self, ShadowFrame& sf, const Instruction* inst,
+                                      uint16_t inst_data,
+                                      const instrumentation::Instrumentation* instrumentation)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  ArtField* f = ArtWasmResolvedStaticField<do_access_check>(sf, inst);
+  if (UNLIKELY(f == nullptr || instrumentation->HasFieldReadListeners())) {
+    return DoFieldGet<find_type, field_type, do_access_check>(self, sf, inst, inst_data);
+  }
+  ObjPtr<mirror::Class> obj = f->GetDeclaringClass();
+  const uint32_t vregA = inst->VRegA_21c(inst_data);
+  switch (field_type) {
+    case Primitive::kPrimBoolean: sf.SetVReg(vregA, f->GetBoolean(obj)); break;
+    case Primitive::kPrimByte: sf.SetVReg(vregA, f->GetByte(obj)); break;
+    case Primitive::kPrimChar: sf.SetVReg(vregA, f->GetChar(obj)); break;
+    case Primitive::kPrimShort: sf.SetVReg(vregA, f->GetShort(obj)); break;
+    case Primitive::kPrimInt: sf.SetVReg(vregA, f->GetInt(obj)); break;
+    case Primitive::kPrimLong: sf.SetVRegLong(vregA, f->GetLong(obj)); break;
+    case Primitive::kPrimNot: sf.SetVRegReference(vregA, f->GetObject(obj).Ptr()); break;
+    default: UNREACHABLE();
+  }
+  return true;
+}
+
+template<FindFieldType find_type, Primitive::Type field_type, bool do_access_check,
+         bool transaction_active>
+ALWAYS_INLINE static bool ArtWasmSPut(Thread* self, const ShadowFrame& sf,
+                                      const Instruction* inst, uint16_t inst_data,
+                                      const instrumentation::Instrumentation* instrumentation)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  ArtField* f = ArtWasmResolvedStaticField<do_access_check>(sf, inst);
+  if (UNLIKELY(f == nullptr || instrumentation->HasFieldWriteListeners())) {
+    return DoFieldPut<find_type, field_type, do_access_check, transaction_active>(
+        self, sf, inst, inst_data);
+  }
+  ObjPtr<mirror::Class> obj = f->GetDeclaringClass();
+  const uint32_t vregA = inst->VRegA_21c(inst_data);
+  switch (field_type) {
+    case Primitive::kPrimBoolean:
+      f->SetBoolean<transaction_active>(obj, sf.GetVReg(vregA));
+      break;
+    case Primitive::kPrimByte: f->SetByte<transaction_active>(obj, sf.GetVReg(vregA)); break;
+    case Primitive::kPrimChar: f->SetChar<transaction_active>(obj, sf.GetVReg(vregA)); break;
+    case Primitive::kPrimShort: f->SetShort<transaction_active>(obj, sf.GetVReg(vregA)); break;
+    case Primitive::kPrimInt: f->SetInt<transaction_active>(obj, sf.GetVReg(vregA)); break;
+    case Primitive::kPrimLong: f->SetLong<transaction_active>(obj, sf.GetVRegLong(vregA)); break;
+    case Primitive::kPrimNot:
+      f->SetObj<transaction_active>(obj, sf.GetVRegReference(vregA));
+      break;
+    default: UNREACHABLE();
+  }
+  return true;
+}
