+template<Primitive::Type field_type, bool transaction_active>
+ALWAYS_INLINE static bool ArtWasmIPutQuick(const ShadowFrame& sf, const Instruction* inst,
+                                           uint16_t inst_data,
+                                           const instrumentation::Instrumentation* instrumentation)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  mirror::Object* obj = sf.GetVRegReference(inst->VRegB_22c(inst_data));
+  if (UNLIKELY(obj == nullptr || instrumentation->HasFieldWriteListeners())) {
