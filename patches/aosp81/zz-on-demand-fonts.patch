+            const uint8_t* r = cblc + arrayOffset + 8 * j;
+            if (readBe16(r) <= glyph && glyph <= readBe16(r + 2)) {
+                record = arrayOffset + 8 * j;
+                found = true;
+                break;
+            }
+        }
+        if (!found) return false;
+        // IndexSubtableRecord::get_image_data: in 1.4.2 the subtable's offset is
+        // from the record itself (index formats 1 and 3).
+        const uint8_t* r = cblc + record;
+        const uint32_t first = readBe16(r), last = readBe16(r + 2);
+        const uint64_t subtable = record + readBe32(r + 4);
+        if (glyph < first || glyph > last || !inCblc(subtable, 8)) return false;
+        const uint8_t* header = cblc + subtable;
+        const uint16_t indexFormat = readBe16(header);
+        const uint16_t imageFormat = readBe16(header + 2);
+        const uint32_t idx = glyph - first;
+        uint32_t start, end;
+        if (indexFormat == 1) {
+            if (!inCblc(subtable + 8, (uint64_t(idx) + 2) * 4)) return false;
+            start = readBe32(header + 8 + 4 * idx);
+            end = readBe32(header + 8 + 4 * (idx + 1));
+        } else if (indexFormat == 3) {
+            if (!inCblc(subtable + 8, (uint64_t(idx) + 2) * 2)) return false;
+            start = readBe16(header + 8 + 2 * idx);
+            end = readBe16(header + 8 + 2 * (idx + 1));
+        } else {
+            return false;
+        }
+        if (end <= start) return false;
+        const uint32_t imageOffset = readBe32(header + 4) + start;
+        const uint32_t imageLength = end - start;
+        if (imageOffset > b.cbdtLength || b.cbdtLength - imageOffset < imageLength) return false;
+        if (imageFormat != 17 || imageLength < 9) return false;
+        // Small glyph metrics: height, width, bearingX, bearingY.
+        uint8_t metrics[4];
+        int fd = open(face->path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0) return false;
+        const bool read = preadFully(fd, metrics, sizeof(metrics), b.cbdtOffset + imageOffset);
+        close(fd);
+        if (!read) return false;
+        extents->x_bearing = int8_t(metrics[2]);
+        extents->y_bearing = int8_t(metrics[3]);
+        extents->width = metrics[1];
+        extents->height = -int(metrics[0]);
+        const float upem = b.upem;
+        extents->x_bearing *= upem / (float)xPpem;
+        extents->y_bearing *= upem / (float)yPpem;
+        extents->width *= upem / (float)xPpem;
+        extents->height *= upem / (float)yPpem;
+        return true;
+    }
+    return false;
+}
+
+// hb_ot_get_glyph_extents for a font whose only glyph data is CBDT.
+hb_bool_t fileFaceBitmapExtents(hb_font_t* font, void* fontData, hb_codepoint_t glyph,
+                                hb_glyph_extents_t* extents, void* /* userData */) {
+    FileFace* face = reinterpret_cast<FileFace*>(fontData);
+    const bool ret = fileFaceBitmapExtentsInFontUnits(face, font, glyph, extents);
+    int xScale, yScale;
+    hb_font_get_scale(font, &xScale, &yScale);
+    const int upem = hb_face_get_upem(hb_font_get_face(font));
+    extents->x_bearing = emScale(extents->x_bearing, xScale, upem);
+    extents->y_bearing = emScale(extents->y_bearing, yScale, upem);
+    extents->width = emScale(extents->width, xScale, upem);
+    extents->height = emScale(extents->height, yScale, upem);
+    return ret;
+}
+
+hb_font_funcs_t* fileFaceBitmapFuncs() {
+    static hb_font_funcs_t* funcs = nullptr;
+    static std::once_flag once;
+    std::call_once(once, [&]() {
+        funcs = hb_font_funcs_create();
+        hb_font_funcs_set_glyph_extents_func(funcs, fileFaceBitmapExtents, nullptr, nullptr);
+        hb_font_funcs_make_immutable(funcs);
+    });
+    return funcs;
+}
+
+// Whether HarfBuzz would take glyph extents from CBDT (hb_ot_get_glyph_extents
+// tries glyf first).
+bool usesBitmapExtents(const FileFace* face) {
+    return face->find(MinikinFont::MakeTag('C', 'B', 'D', 'T')) != nullptr &&
+           face->find(MinikinFont::MakeTag('C', 'B', 'L', 'C')) != nullptr &&
+           face->find(MinikinFont::MakeTag('g', 'l', 'y', 'f')) == nullptr;
+}
+
+hb_face_t* createFileFace(const char* path, uint32_t ttcIndex) {
+    std::unique_ptr<FileFace> face(new FileFace{path, {}});
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || !readFileFaceTables(fd, ttcIndex, &face->tables)) {
+        ALOGE("Could not read the table directory of %s", path);
+    }
+    if (fd >= 0) close(fd);
+    FileFace* fileFace = face.release();
+    hb_face_t* hbFace = hb_face_create_for_tables(
+            referenceFileFaceTable, fileFace,
+            [](void* p) { delete reinterpret_cast<FileFace*>(p); });
+    hb_face_set_user_data(hbFace, &gFileFaceKey, fileFace, nullptr, false);
+    hb_face_set_index(hbFace, ttcIndex);
+    return hbFace;
+}
+
+}  // namespace
+
+bool fileFaceHasTable(hb_face_t* face, uint32_t tag, bool* hasTable) {
+    const FileFace* fileFace =
+            reinterpret_cast<const FileFace*>(hb_face_get_user_data(face, &gFileFaceKey));
+    if (fileFace == nullptr) return false;
+    *hasTable = fileFace->find(tag) != nullptr;
+    return true;
+}
