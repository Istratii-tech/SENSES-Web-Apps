+
+uint32_t readBe32(const uint8_t* p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+
+bool preadFully(int fd, void* buf, size_t len, off_t off) {
+    uint8_t* p = reinterpret_cast<uint8_t*>(buf);
+    while (len > 0) {
+        ssize_t n = pread(fd, p, len, off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return false;
+        p += n;
+        len -= n;
+        off += n;
+    }
+    return true;
+}
+
+// The table records of the font (of font ttcIndex of a collection).
+bool readFileFaceTables(int fd, uint32_t ttcIndex, std::vector<FileFaceTable>* out) {
+    struct stat st;
+    if (fstat(fd, &st) != 0) return false;
+    uint8_t header[12];
+    if (!preadFully(fd, header, sizeof(header), 0)) return false;
+    uint32_t base = 0;
+    if (readBe32(header) == MinikinFont::MakeTag('t', 't', 'c', 'f')) {
+        if (ttcIndex >= readBe32(header + 8)) return false;
+        uint8_t offset[4];
+        if (!preadFully(fd, offset, sizeof(offset), 12 + 4 * ttcIndex)) return false;
+        base = readBe32(offset);
+        if (!preadFully(fd, header, sizeof(header), base)) return false;
+    }
+    const uint32_t numTables = (uint32_t(header[4]) << 8) | header[5];
+    std::vector<uint8_t> records(16 * numTables);
+    if (!preadFully(fd, records.data(), records.size(), base + 12)) return false;
+    for (uint32_t i = 0; i < numTables; i++) {
+        const uint8_t* r = &records[16 * i];
+        FileFaceTable t = {readBe32(r), readBe32(r + 8), readBe32(r + 12)};
+        if (uint64_t(t.offset) + t.length > uint64_t(st.st_size)) continue;
+        out->push_back(t);
+    }
+    return true;
+}
+
+hb_blob_t* referenceFileFaceTable(hb_face_t*, hb_tag_t tag, void* userData) {
+    const FileFace* face = reinterpret_cast<const FileFace*>(userData);
+    for (const FileFaceTable& t : face->tables) {
+        if (t.tag != tag) continue;
+        if (t.length == 0) return nullptr;
+        int fd = open(face->path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0) return nullptr;
+        constexpr uint32_t kPage = 65536;
+        const uint32_t start = t.offset & ~(kPage - 1);
+        const size_t length = t.offset + t.length - start;
+        void* addr = mmap(nullptr, length, PROT_READ, MAP_SHARED, fd, start);
+        close(fd);
+        if (addr == MAP_FAILED) {
+            ALOGE("Could not map table %08x of %s", tag, face->path.c_str());
+            return nullptr;
+        }
+        FileFaceMapping* mapping = new FileFaceMapping{addr, length};
+        return hb_blob_create(reinterpret_cast<const char*>(addr) + (t.offset - start), t.length,
+                              HB_MEMORY_MODE_READONLY, mapping, [](void* p) {
+                                  FileFaceMapping* m = reinterpret_cast<FileFaceMapping*>(p);
+                                  munmap(m->addr, m->length);
+                                  delete m;
+                              });
