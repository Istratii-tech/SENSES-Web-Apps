+// arc-wasm (fonts on demand): the HarfBuzz face of a font that is a file and
+// not in memory (MinikinFont::GetFontPath; getHbFontLocked). Mapping a whole font fills all of
+// it in WebAssembly (no MMU: a mapping is complete when mmap returns), while
+// layout reads only the table directory and a few tables (cmap for the
+// coverage; GSUB, GPOS, GDEF, hmtx... when shaping with it). So each table is
+// mapped by itself when HarfBuzz first asks for it: the mapping starts at the
+// 64 KiB page that holds the table (the VFS's mmap offsets are multiples of
+// the wasm page; also a multiple of any CPU page), MAP_SHARED and read-only,
+// which the VFS gives as the /system image's own pages.
+namespace {
+
+struct FileFaceTable {
+    uint32_t tag;
+    uint32_t offset;
+    uint32_t length;
+};
+
+// Glyph extents of a color bitmap font (CBDT/CBLC) without CBDT in memory:
+// minikin asks HarfBuzz for the extents of every emoji it lays out (Layout),
+// and HarfBuzz's CBDT code holds the whole table (here 9 MB of PNGs) to read
+// four bytes of metrics per glyph. FileFaceBitmaps does what HarfBuzz 1.4.2
+// does (hb-ot-font.cc, hb_ot_face_cbdt_accelerator_t, hb-ot-cbdt-table.hh,
+// and the em scaling of hb_ot_get_glyph_extents) with CBLC mapped and the
+// glyph's metrics read from the file.
+struct FileFaceBitmaps {
+    std::once_flag once;
+    hb_blob_t* cblc = nullptr;
+    uint32_t cbdtOffset = 0;
+    uint32_t cbdtLength = 0;  // 0 if CBDT is not valid (as HarfBuzz's empty blob)
+    int upem = 0;
+};
+
+struct FileFace {
+    std::string path;
+    std::vector<FileFaceTable> tables;
+    FileFaceBitmaps bitmaps;
+
+    const FileFaceTable* find(uint32_t tag) const {
+        for (const FileFaceTable& t : tables) {
+            if (t.tag == tag && t.length > 0) return &t;
+        }
+        return nullptr;
+    }
+    ~FileFace() { hb_blob_destroy(bitmaps.cblc); }
+};
+
+hb_user_data_key_t gFileFaceKey;
+
+struct FileFaceMapping {
+    void* addr;
+    size_t length;
