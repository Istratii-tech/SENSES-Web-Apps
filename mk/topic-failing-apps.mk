# Topic failing-apps (docs/topics/failing-apps.md): apps of the 104-app sweep
# that showed nothing on Android 10.
#
# Java's OpenGL ES 3 (Godot 4): the EGL and GL JNI of 8.1 and 10
# (mk/topic-fw8-system.mk, mk/topic-fw10-system.mk) are compiled with
# JAVA_GL_FLAGS: their egl* calls go to the router in shim/ndk/ndk_egl.cc
# (arcwasm_jegl_*: OpenGL ES 3 contexts direct on WebGL2, ES 1/2 on
# graphics_translation as before), their gl* calls to shim/ndk/ndk_java_gl.cc
# (arcwasm_jgl_*, by the kind of context current). The renaming of every gl*
# entry point is generated from the bridge's GL lists.
JAVA_GL_GEN := $(BUILD)/gen/java-gl
JAVA_GL_NAMES := $(JAVA_GL_GEN)/ndk_java_gl_names.h
$(JAVA_GL_NAMES): shim/ndk/ndk_gl_list.inc shim/ndk/ndk_gl1_list.inc
	@mkdir -p $(dir $@)
	@{ echo '// Generated by mk/topic-failing-apps.mk from shim/ndk/ndk_gl*_list.inc.'; \
	   sed -nE -e 's/^GLFN\([0-9], [^,]+, (gl[A-Za-z0-9]+),.*/#define \1 arcwasm_jgl_\1/p' \
	           -e 's/^GLFN1\([^,]+, (gl[A-Za-z0-9]+),.*/#define \1 arcwasm_jgl_\1/p' $^; } > $@.tmp
	@mv $@.tmp $@
JAVA_GL_FLAGS := -include shim/ndk/ndk_java_egl.h -I$(JAVA_GL_GEN)
JAVA_GL_SRCS := shim/ndk/ndk_java_gl.cc
