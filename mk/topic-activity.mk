# Topic "activity": a real Activity started the way Android starts one, inside
# the one wasm process (docs/topics/activity.md).
#
#   android.policy.jar  frameworks/base/policy/src (PhoneWindow, PhoneLayoutInflater:
#                       what Activity.attach and LayoutInflater need)
#   services.jar        the in-process system_server: lean "activity", "package",
#                       "power" (+ "display", "input_method", "accessibility",
#                       and a stand-in "window" when none is registered), in
#                       framework/java-arcwasm/arcwasm/server; bases generated by
#                       tools/gen_binder_base.py
#   both on BOOTCLASSPATH after framework2, as in AOSP 4.4.4
#   (dalvik/launcher/dalvikvm.cc), so they are also preoptimized (topic dexopt)
#   /data in Node       shim/opfs/memory_opfs.js: an in-memory OPFS for the Node
#                       build, so /data (and /data/data/PACKAGE) exists there too
#
#   make activity-test  # arcwasm.ActivityTest under Node
#
# Included by the Makefile after mk/dalvik.mk (topic fragments in alphabetical order).

POLICY_JAR := $(DFW)/android.policy.jar
SERVICES_JAR := $(DFW)/services.jar
POLICY_CLASSES := $(DFW)/android.policy-java/android.policy-classes.jar
SERVICES_CLASSES := $(DFW)/services-java/services-classes.jar
POLICY_SRCS := $(shell find $(FWB)/policy/src -name '*.java')
SERVER_SRCS := $(shell find framework/java-arcwasm/arcwasm/server framework/java-arcwasm/arcwasm/webview -name '*.java')

$(POLICY_JAR): tools/build_services_jar.sh $(POLICY_SRCS) $(DFW)/framework.jar
	tools/build_services_jar.sh $(DFW) policy $(FW_CLASSES)
$(POLICY_CLASSES): $(POLICY_JAR) ;
$(SERVICES_JAR): tools/build_services_jar.sh tools/gen_binder_base.py tools/gen_webview_stub.py $(SERVER_SRCS) \
                 $(POLICY_JAR) $(DFW)/framework.jar
	tools/build_services_jar.sh $(DFW) services $(FW_CLASSES)
$(SERVICES_CLASSES): $(SERVICES_JAR) ;

# The /system image takes every jar of FW_BOOT_JARS (expanded in its recipe).
FW_BOOT_JARS += android.policy services
$(DSYSTEM_IMAGE): $(POLICY_JAR) $(SERVICES_JAR)
# The tests compile against them (ActivityTest starts arcwasm.server.SystemServer).
BOOT_CLASSES := $(BOOT_CLASSES):$(POLICY_CLASSES):$(SERVICES_CLASSES)
$(DFW)/arc-tests.jar: $(POLICY_JAR) $(SERVICES_JAR)

# Node has no OPFS: an in-memory one, so /data is mounted as in the browser.
ACTIVITY_NODE_PRE_JS := shim/opfs/memory_opfs.js
$(BUILD)/dalvik/dalvikvm.js: DVM_LDFLAGS += --pre-js $(ACTIVITY_NODE_PRE_JS)
$(BUILD)/dalvik/dalvikvm.js: $(ACTIVITY_NODE_PRE_JS) mk/topic-activity.mk

.PHONY: activity-jars activity-test
activity-jars: $(POLICY_JAR) $(SERVICES_JAR)
activity-test: dalvik
	cd $(BUILD)/dalvik && $(NODE) dalvikvm.js -cp /system/framework/arc-tests.jar arcwasm.ActivityTest
