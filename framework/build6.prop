# begin build properties
# arc-wasm: the properties AOSP 6.0.1's build/tools/buildinfo.sh writes for
# android-6.0.1_r81 (values from build/core/version_defaults.mk and
# build_id.mk), loaded into the property store at startup by artvm
# (shim/fw6/system_properties.cc) as init does. android.os.Build reads
# them; Resources passes Build.VERSION.RESOURCES_SDK_INT to the
# AssetManager, and resources only match configurations up to that SDK
# version.
ro.build.id=MOI10E
ro.build.display.id=MOI10E
ro.build.version.incremental=eng.arcwasm
ro.build.version.sdk=23
ro.build.version.preview_sdk=0
ro.build.version.codename=REL
ro.build.version.all_codenames=REL
ro.build.version.release=6.0.1
ro.build.version.security_patch=2016-10-05
ro.build.version.base_os=
ro.build.date=Thu Oct 16 00:00:00 UTC 2026
ro.build.date.utc=1792022400
ro.build.type=eng
ro.build.user=arcwasm
ro.build.host=arcwasm
ro.build.tags=test-keys
ro.build.flavor=arcwasm-eng
ro.product.model=arc-wasm
ro.product.brand=arcwasm
ro.product.name=arcwasm
ro.product.device=wasm32
ro.product.board=browser
# ro.product.cpu.abi and ro.product.cpu.abi2 are obsolete,
# use ro.product.cpu.abilist instead.
ro.product.cpu.abi=armeabi-v7a
ro.product.cpu.abi2=armeabi
ro.product.cpu.abilist=armeabi-v7a,armeabi
ro.product.cpu.abilist32=armeabi-v7a,armeabi
ro.product.cpu.abilist64=
ro.product.manufacturer=arc-wasm
ro.product.locale=en-US
ro.wifi.channels=
ro.board.platform=browser
# ro.build.product is obsolete; use ro.product.device
ro.build.product=wasm32
# Do not try to parse description, fingerprint, or thumbprint
ro.build.description=arcwasm-eng 6.0.1 MOI10E eng.arcwasm test-keys
ro.build.fingerprint=arcwasm/arcwasm/wasm32:6.0.1/MOI10E/eng.arcwasm:eng/test-keys
ro.build.characteristics=default
# end build properties
#
# ADDITIONAL_BUILD_PROPERTIES
#
# The VM is ART (persist.sys.dalvik.vm.lib.2 on a device).
persist.sys.dalvik.vm.lib.2=libart.so
dalvik.vm.isa.arm.variant=cortex-a15
dalvik.vm.isa.arm.features=default
ro.zygote=zygote32
