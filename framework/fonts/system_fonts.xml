<?xml version="1.0" encoding="utf-8"?>
<!--
    arc-wasm: the fonts shipped in the /system image, a subset of
    frameworks/base/data/fonts/system_fonts.xml (same format: Skia's
    SkFontConfigParser_android reads it from /system/etc). Font files are
    the AOSP 4.4.4 ones from frameworks/base/data/fonts, copied to
    /system/fonts by mk/topic-graphics.mk. The first family is the default.
-->
<familyset>
    <family>
        <nameset>
            <name>sans-serif</name>
            <name>arial</name>
            <name>helvetica</name>
            <name>tahoma</name>
            <name>verdana</name>
        </nameset>
        <fileset>
            <file>Roboto-Regular.ttf</file>
            <file>Roboto-Bold.ttf</file>
            <file>Roboto-Italic.ttf</file>
            <file>Roboto-BoldItalic.ttf</file>
        </fileset>
    </family>
    <family>
        <nameset>
            <name>monospace</name>
            <name>courier</name>
            <name>courier new</name>
            <name>monaco</name>
        </nameset>
        <fileset>
            <file>DroidSansMono.ttf</file>
        </fileset>
    </family>
</familyset>
