<?xml version="1.0" encoding="utf-8"?>
<!-- arc-wasm: text fields for the page's keyboard (topic ios-audio-keyboard,
     docs/topics/ios-audio-keyboard.md). Its log lines (tag ImeTest) say what
     the fields hold, which editor actions came and how tall the window's
     content is (adjustResize under the keyboard). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.arcwasm.imetest" android:versionCode="1" android:versionName="1.0">
    <application android:label="@string/app_name">
        <activity android:name=".MainActivity" android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
