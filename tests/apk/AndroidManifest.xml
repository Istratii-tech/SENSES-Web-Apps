<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK for arcwasm.ApkTest (tests/java/arcwasm/ApkTest.java), built by
     tools/build_test_apk.sh: its code is loaded with a class loader, its
     resources with android.content.res.AssetManager. arcwasm.ActivityTest
     installs it (the "package" service) and launches MainActivity, the
     launcher activity, through the "activity" service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.arcwasm.testapp"
    android:versionCode="7"
    android:versionName="1.7">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <application android:name=".TestApplication"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SecondActivity" android:label="@string/second_title" />
    </application>
</manifest>
