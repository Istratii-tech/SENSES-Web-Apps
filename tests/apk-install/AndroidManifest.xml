<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK for arcwasm.InstallTest (tests/java/arcwasm/InstallTest.java,
     topic install8): installed from SENSES Web Apps' library (/mnt/apps) on
     4.4, 6.0.1 and 8.1. Built twice (mk/topic-install8.mk): versionCode 1 and
     2, with an ARM library in lib/armeabi-v7a to be copied out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.arcwasm.installtest"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <application android:label="@string/app_name">
        <activity android:name=".MainActivity" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
